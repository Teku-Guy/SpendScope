// prisma/schema.prisma - Updated with NextAuth support

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@map("accounts")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("sessions")
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // SpendScope specific fields (encrypted)
    plaidAccessToken String? @db.Text  // Will be encrypted
    plaidItemId      String? @db.Text  // Will be encrypted
    preferences      Json?    @default("{}")
    monthlyBudget    Decimal? @db.Decimal(10, 2)

    // 2FA settings
    twoFactorEnabled     Boolean @default(false)
    twoFactorMethods     String[] // Array of enabled methods: 'totp', 'email', 'sms', 'passkey'
    totpSecret           String? @db.Text  // Encrypted TOTP secret
    backupCodes          String[] // Array of encrypted backup codes
    twoFactorVerifiedAt  DateTime?

    // Phone for SMS 2FA (optional, encrypted)
    phone                String? @db.Text
    phoneVerified        Boolean @default(false)
    phoneVerifiedAt      DateTime?

    // NextAuth relations
    accounts Account[]
    sessions Session[]

    // SpendScope relations
    bankAccounts     BankAccount[]
    transactions     Transaction[]
    predictions      SpendingPrediction[]
    budgetAlerts     BudgetAlert[]
    budgetCategories BudgetCategory[]
    dashboardLayouts DashboardLayout[]
    dashboardPresets DashboardPreset[]

    // 2FA relations
    trustedDevices   TrustedDevice[]
    passkeys         Passkey[]
    twoFactorTokens  TwoFactorToken[]

    @@map("users")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
    @@map("verificationtokens")
}

// SpendScope specific models (renamed to avoid conflict with NextAuth Account)
model BankAccount {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Plaid account data
    plaidAccountId String  @unique
    name           String
    officialName   String?
    type           String
    subtype        String?
    balance        Decimal @db.Decimal(12, 2)

    // PostgreSQL JSON for metadata
    metadata Json? @default("{}")

    transactions Transaction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("bank_accounts")
}

model Transaction {
    id        String      @id @default(cuid())
    userId    String
    user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    accountId String
    account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

    // Plaid transaction data
    plaidTransactionId String   @unique
    amount             Decimal  @db.Decimal(10, 2)
    date               DateTime
    name               String
    merchantName       String?

    // Categorization
    category    String
    subcategory String?
    isEssential Boolean @default(false)

    // AI predictions & metadata (PostgreSQL JSON advantage)
    aiData        Json? @default("{}")
    plaidMetadata Json? @default("{}")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // PostgreSQL index for better performance
    @@index([userId, date])
    @@index([category])
    @@map("transactions")
}

model SpendingPrediction {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    month          Int
    year           Int
    predictedTotal Decimal  @db.Decimal(12, 2)
    actualTotal    Decimal? @db.Decimal(12, 2)
    confidence     Float

    // Category breakdowns (PostgreSQL JSONB advantage)
    predictions Json  @default("{}")
    metadata    Json? @default("{}")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, month, year])
    @@map("spending_predictions")
}

model BudgetCategory {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    name         String
    budgetLimit  Decimal @db.Decimal(10, 2)
    currentSpend Decimal @default(0) @db.Decimal(10, 2)
    category     String

    // PostgreSQL JSON for flexible category rules
    rules Json? @default("{}")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("budget_categories")
}

model BudgetAlert {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    type     AlertType
    category String?
    message  String
    severity AlertSeverity
    isRead   Boolean       @default(false)

    // Financial amounts with proper precision
    currentAmount   Decimal? @db.Decimal(10, 2)
    budgetLimit     Decimal? @db.Decimal(10, 2)
    projectedAmount Decimal? @db.Decimal(10, 2)

    // Additional metadata
    metadata Json? @default("{}")

    createdAt DateTime @default(now())

    @@map("budget_alerts")
}

enum AlertType {
    BUDGET_EXCEEDED
    PROJECTED_OVERSPEND
    UNUSUAL_SPENDING
    BILL_DUE
    SAVINGS_OPPORTUNITY
}

enum AlertSeverity {
    LOW
    MEDIUM
    HIGH
    CRITICAL
}

// Dashboard customization models
model DashboardLayout {
    id          String  @id @default(cuid())
    userId      String
    user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    name        String
    description String?
    isDefault   Boolean @default(false)
    isActive    Boolean @default(false)

    // Layout configuration stored as JSON
    layoutData      Json    // LayoutItem[] for each breakpoint
    widgetConfigs   Json?   @default("{}")  // Widget-specific configurations
    themeConfig     Json?   @default("{}")  // Color themes, spacing, etc.

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([userId, name])
    @@map("dashboard_layouts")
}

model DashboardPreset {
    id          String  @id @default(cuid())
    createdBy   String?
    creator     User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

    name        String
    description String
    thumbnailUrl String?
    category    PresetCategory @default(TEMPLATE)
    tags        String[]

    // Layout configuration
    layoutData      Json    // Complete layout configuration
    widgetConfigs   Json?   @default("{}")
    themeConfig     Json?   @default("{}")

    // Community features
    isPublic        Boolean @default(false)
    usageCount      Int     @default(0)
    rating          Float?  // Average rating
    ratingCount     Int     @default(0)

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("dashboard_presets")
}

// Preset rating system
model PresetRating {
    id        String  @id @default(cuid())
    userId    String
    presetId  String
    rating    Int     // 1-5 stars
    comment   String?

    createdAt DateTime @default(now())

    @@unique([userId, presetId])
    @@map("preset_ratings")
}

enum PresetCategory {
    DEFAULT     // Built-in system presets
    TEMPLATE    // Starting templates
    COMMUNITY   // User-shared presets
    PERSONAL    // Private user presets
}

// 2FA and Security Models
model TrustedDevice {
    id            String   @id @default(cuid())
    userId        String
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    deviceFingerprint String   // Unique device identifier
    deviceName        String?  // User-friendly device name
    userAgent         String?  // Browser/device info
    ipAddress         String?  // Last known IP

    // Device trust info
    trusted           Boolean @default(true)
    trustLevel        TrustLevel @default(MEDIUM)

    // Timestamps
    firstSeen         DateTime @default(now())
    lastSeen          DateTime @default(now())
    trustedAt         DateTime @default(now())
    expiresAt         DateTime? // Optional expiry for device trust

    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@unique([userId, deviceFingerprint])
    @@map("trusted_devices")
}

model Passkey {
    id                String   @id @default(cuid())
    userId            String
    user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    name              String   // User-given name for the passkey
    credentialId      String   @unique  // WebAuthn credential ID (base64)
    publicKey         String   @db.Text // Public key for verification
    counter           BigInt   // WebAuthn signature counter

    // Device info
    deviceType        String?  // 'platform' or 'cross-platform'

    // Timestamps
    createdAt         DateTime @default(now())
    lastUsedAt        DateTime?

    @@map("passkeys")
}

model TwoFactorToken {
    id            String      @id @default(cuid())
    userId        String
    user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

    token         String      // Encrypted token
    type          TokenType   // 'email', 'sms', 'backup'

    // Expiry and usage
    expiresAt     DateTime
    usedAt        DateTime?
    attempts      Int         @default(0)
    maxAttempts   Int         @default(3)

    // Additional data
    metadata      Json?       @default("{}")  // Extra info like email/phone used

    createdAt     DateTime    @default(now())

    @@index([token])
    @@index([expiresAt])
    @@map("two_factor_tokens")
}

enum TrustLevel {
    LOW
    MEDIUM
    HIGH
}

enum TokenType {
    EMAIL
    SMS
    BACKUP
}
